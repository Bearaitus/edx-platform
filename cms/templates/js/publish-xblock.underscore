<%
var title = gettext("Черновик (Никогда не публиковался)");
if (visibilityState === 'staff_only') {
    title = gettext("Доступно только для сотрудников");
} else if (visibilityState === 'live') {
    title = gettext("Опубликовано и в сети");
} else if (published && !hasChanges) {
    title = gettext("Опубликовано (еще не выпущено)");
} else if (published && hasChanges) {
    title = gettext("Черновик (Неопубликованные изменения)");
}

var releaseLabel = gettext("Дата выпуска:");
if (visibilityState === 'live') {
    releaseLabel = gettext("Дата выпуска:");
} else if (visibilityState === 'ready') {
    releaseLabel = gettext("Запланировано:");
}

var visibleToStaffOnly = visibilityState === 'staff_only';
%>
<div class="bit-publishing <%- visibilityClass %> <% if (releaseDate) { %>is-scheduled<% } %>">
    <h3 class="bar-mod-title pub-status"><span class="sr"><%- gettext("Статус публикации") %></span>
        <%- title %>
    </h3>

    <div class="wrapper-last-draft bar-mod-content">
        <p class="copy meta">
            <% if (hasChanges && editedOn && editedBy) { %>
                <%= HtmlUtils.interpolateHtml(
                        gettext("Черновик сохранен {lastSavedStart}{editedOn}{lastSavedEnd} пользователем {editedByStart}{editedBy}{editedByEnd}"),
                        {
                            lastSavedStart: HtmlUtils.HTML('<span class="date">'),
                            editedOn: editedOn,
                            lastSavedEnd: HtmlUtils.HTML('</span>'),
                            editedByStart: HtmlUtils.HTML('<span class="user">'),
                            editedBy: editedBy,
                            editedByEnd: HtmlUtils.HTML('</span>')
                        }
                    ) %>
            <% } else if (publishedOn && publishedBy) { %>
                <%= HtmlUtils.interpolateHtml(
                        gettext("Последнее опубликовано {lastPublishedStart}{publishedOn}{lastPublishedEnd} пользователем {publishedByStart}{publishedBy}{publishedByEnd}"),
                        {
                            lastPublishedStart: HtmlUtils.HTML('<span class="date">'),
                            publishedOn: publishedOn,
                            lastPublishedEnd: HtmlUtils.HTML('</span>'),
                            publishedByStart: HtmlUtils.HTML('<span class="user">'),
                            publishedBy: publishedBy,
                            publishedByEnd: HtmlUtils.HTML('</span>')
                        }
                    ) %>
            <% } else { %>
                <%- gettext("Ранее опубликовано") %>
            <% } %>
        </p>
    </div>

    <% if (!course.get('self_paced')) { %>
        <div class="wrapper-release bar-mod-content">
            <h5 class="title"><%- releaseLabel %></h5>
            <p class="copy">
                <% if (releaseDate) { %>
                    <span class="release-date"><%- releaseDate %></span>
                    <span class="release-with">
                        <%- interpolate(
                            gettext('с %(release_date_from)s'), { release_date_from: releaseDateFrom }, true
                        ) %>
                    </span>

                <% } else { %>
                    <%- gettext("Не запланировано") %>
                <% } %>
            </p>
        </div>
    <% } %>

    <div class="wrapper-visibility bar-mod-content">
        <h5 class="title">
            <% if (released && published && !hasChanges) { %>
                <%- gettext("Доступно для:") %>
            <% } else { %>
                <%- gettext("Будет доступно для:") %>
            <% } %>
        </h5>
        <% if (visibleToStaffOnly) { %>
            <p class="visbility-copy copy">
                <%- gettext("Только для сотрудников") %>
                <% if (!hasExplicitStaffLock) { %>
                    <span class="inherited-from">
                        <%- interpolate(
                            gettext("с %(section_or_subsection)s"),{ section_or_subsection: staffLockFrom }, true
                        ) %>
                    </span>
                <% } %>
            </p>
        <% } else { %>
            <p class="visbility-copy copy"><%- gettext("Для сотрудников и учащихся") %></p>
        <% } %>
    </div>

    <div class="wrapper-pub-actions bar-mod-actions">
        <ul class="action-list">
            <li class="action-item">
                <a class="action-publish action-primary <% if (published && !hasChanges) { %>is-disabled<% } %>"
                   href="" aria-disabled="<% if (published && !hasChanges) { %>true<% } else { %>false<% } %>" ><%- gettext("Опубликовать") %>
                </a>
            </li>
        </ul>
    </div>
</div>
