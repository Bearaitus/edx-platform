<%
var title = gettext("Не опубликовано");
if (visibilityState === 'staff_only') {
    title = gettext("Доступно только для сотрудников");
} else if (visibilityState === 'live') {
    title = gettext("Опубликовано");
} else if (published && !hasChanges) {
    title = gettext("Опубликовано (еще не выпущено)");
} else if (published && hasChanges) {
    title = gettext("Черновик (Неопубликованные изменения)");
}

var releaseLabel = gettext("Дата выпуска:");
if (visibilityState === 'live') {
    releaseLabel = gettext("Дата выпуска:");
} else if (visibilityState === 'ready') {
    releaseLabel = gettext("Запланировано:");
}

var visibleToStaffOnly = visibilityState === 'staff_only';
%>
<div class="bit-publishing <%- visibilityClass %> <% if (releaseDate) { %>is-scheduled<% } %>">
    <h3 class="bar-mod-title pub-status"><span class="sr"><%- gettext("Статус публикации") %></span>
        <%- title %>
    </h3>

    <div class="wrapper-pub-actions bar-mod-actions">
        <ul class="action-list">
            <li class="action-item">
                <a class="action-publish action-primary <% if (published && !hasChanges) { %>is-disabled<% } %>"
                   href="" aria-disabled="<% if (published && !hasChanges) { %>true<% } else { %>false<% } %>" ><%- gettext("Опубликовать") %>
                </a>
            </li>
        </ul>
    </div>
</div>
